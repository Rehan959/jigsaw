{
  "name": "@jigsaw/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JigSaw MCP server — Playwright browser automation + knowledge base search",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "bin": {
    "jigsaw-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@playwright/mcp": "^0.0.79",
    "@jigsaw/shared": "workspace:*",
    "@jigsaw/ingestion": "workspace:*",
    "@jigsaw/db": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "drizzle-orm": "^0.33.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^24.3.0"
  }
}
